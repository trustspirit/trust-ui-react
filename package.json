{
  "name": "trust-ui-react",
  "version": "1.0.1",
  "description": "A mobile-optimized, themeable React UI library — 26 components, native touch UX, CSS-variable theming, sophisticated v2 design system.",
  "type": "module",
  "main": "./dist/index.cjs.js",
  "module": "./dist/index.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js",
      "require": "./dist/index.cjs.js"
    },
    "./styles.css": "./dist/styles.css",
    "./market.css": "./dist/market.css",
    "./compat.css": "./dist/compat.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "storybook dev -p 6006",
    "build": "vite build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "docs:dev": "cd docs-site && pnpm start",
    "docs:build": "cd docs-site && pnpm build",
    "docs:serve": "cd docs-site && pnpm serve",
    "test": "vitest",
    "test:run": "vitest run",
    "test:visual": "pnpm build-storybook --quiet && playwright test tests/visual/visual.spec.ts",
    "test:visual:update": "pnpm build-storybook --quiet && playwright test tests/visual/visual.spec.ts -u",
    "test:interaction": "pnpm build-storybook --quiet && playwright test tests/visual/interaction.spec.ts",
    "test:geometry": "pnpm build-storybook --quiet && playwright test tests/visual/table-geometry.spec.ts tests/visual/table-rules.spec.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "react",
    "ui",
    "components",
    "typescript",
    "dark-mode",
    "css-modules",
    "design-system"
  ],
  "author": "shinyoung",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/trustspirit/trust-ui-react"
  },
  "packageManager": "pnpm@10.9.0",
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@storybook/addon-a11y": "^8.6.18",
    "@storybook/addon-essentials": "^8.6.18",
    "@storybook/blocks": "^8.6.18",
    "@storybook/react": "^8.6.18",
    "@storybook/react-vite": "^8.6.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "http-server": "^14.1.1",
    "jsdom": "^28.1.0",
    "pretendard": "^1.3.9",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "storybook": "^8.6.18",
    "typescript": "^5.9.3",
    "vite": "^6.4.1",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.11"
  }
}
